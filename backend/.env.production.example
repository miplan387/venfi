# Producción
PORT=8080
NODE_ENV=production
FRONTEND_URL=https://venfidata.com

# Cloud SQL (Ajustar en Google Cloud)
DATABASE_URL=postgresql://postgres:password@localhost/venfi?host=/cloudsql/venfidata-prod:us-central1:venfi-db

# Seguridad
JWT_SECRET=CAMBIAR_ESTO_EN_PRODUCCION
JWT_REFRESH_SECRET=CAMBIAR_ESTO_EN_PRODUCCION

# APIs (Mantener las claves reales)
EIA_API_KEY=tu_clave_aqui
GOLD_API_KEY=tu_clave_aqui
ALLRATES_API_KEY=tu_clave_aqui

# Soporte y Correos
EMAIL_USER=soporte@venfidata.com
SUPPORT_EMAIL=soporte@venfidata.com
SMTP_FROM="Venfidata Soporte" <soporte@venfidata.com>

